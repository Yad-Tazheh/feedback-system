# ==========================================
# Environment Variables Example Configuration
# Copy this file to .env and adjust values.
# ==========================================

# AI Service Configuration (LM Studio / OpenAI compatible API)
LM_STUDIO_URL=http://localhost:1234/v1/chat/completions
LM_MODEL=qwen2.5-7b-instruct
LM_TEMPERATURE=0.4
LM_MAX_TOKENS=150
LM_TIMEOUT=60

# Django Settings Module
# Development: feedback_system.settings.dev
# Production: feedback_system.settings.prod
DJANGO_SETTINGS_MODULE=feedback_system.settings.dev

# Production Security & Secrets (REQUIRED in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
DJANGO_LOG_LEVEL=INFO

# Database Path (Optional: path to SQLite DB file; defaults to BASE_DIR/db.sqlite3)
DJANGO_DB_PATH=

# SSL & Security Overrides (Production defaults to True / 31536000)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
